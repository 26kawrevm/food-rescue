{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node -e \"require('fs').cpSync('src/main/resources/static','dist',{recursive:true})\"",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://food-rescue-api-v4a5.onrender.com/api/:path*"
    }
  ]
}
